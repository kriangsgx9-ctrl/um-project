DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prime_um_ascend?schema=public"
# Production: generate with `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
# and set it in your hosting provider's dashboard — never commit a real value.
AUTH_SECRET="dev-secret-change-me"
# Optional: absolute path for evidence file uploads. Defaults to <cwd>/public/uploads
# if unset — only needed when the process's cwd doesn't match the project root.
# Ignored entirely once BLOB_READ_WRITE_TOKEN is set (see below).
# EVIDENCE_UPLOAD_DIR="/absolute/path/to/prime-um-ascend-v2/public/uploads"
# Production on Vercel: attach a Blob store to the project in the Vercel
# dashboard (Storage tab) and it sets this automatically — evidence uploads
# then go to Vercel Blob instead of local disk, which is required since
# Vercel's filesystem is ephemeral. Leave unset for local dev / self-hosting.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
